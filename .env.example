# Application
NEXT_PUBLIC_APP_NAME=Wagesse
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=XOF
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wagesse"

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=7d
NEXT_PUBLIC_JWT_EXPIRATION=7d

# Payment Provider - Orange Money (Sandbox)
PAYMENT_PROVIDER=orange_money_sandbox
ORANGE_MONEY_API_KEY=sandbox_key_do_not_use_in_production
ORANGE_MONEY_API_URL=https://api.sandbox.orange.fr
ORANGE_MONEY_MERCHANT_ID=demo_merchant
NEXT_PUBLIC_ORANGE_MONEY_MERCHANT_ID=demo_merchant

# Payment Provider - Stripe (Alternative)
STRIPE_SECRET_KEY=sk_test_your_test_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=wagesse-uploads

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NEXT_PUBLIC_FROM_EMAIL=noreply@wagesse.bf

# SMS Service
SMS_PROVIDER=twilio_sandbox
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Analytics & Logging
SENTRY_DSN=https://your_sentry_key@sentry.io/project_id

# Admin Panel
NEXT_PUBLIC_ADMIN_PATH=/admin
ADMIN_SECRET_TOKEN=super_secret_admin_token

# Mapbox (Optional, for maps)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Feature Flags
FEATURE_RECURRING_MISSIONS=true
FEATURE_ADVANCED_MATCHING=true
FEATURE_SUBSCRIPTION_PLANS=true
