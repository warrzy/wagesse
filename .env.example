# Application
NEXT_PUBLIC_APP_NAME=Wagesse
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=XOF
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:@127.0.0.1:3306/wagesse"

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=7d
NEXT_PUBLIC_JWT_EXPIRATION=7d

# Payment Provider - Orange Money
# Leave PAYMENT_PROVIDER=orange_money_sandbox to keep using the built-in
# simulated payment screen (no real account needed, nothing below is read).
#
# To go live: create an app at https://developer.orange.com, subscribe it to
# the "Orange Money Web Payment" API for your country, then set:
#   PAYMENT_PROVIDER=orange_money_production
#   ORANGE_MONEY_CLIENT_ID / ORANGE_MONEY_CLIENT_SECRET  <- from that app (OAuth2 client credentials, NOT your personal Orange Money login)
#   ORANGE_MONEY_MERCHANT_KEY                             <- from your Orange Money merchant agreement
#   ORANGE_MONEY_REGION                                    <- country code used in the API path, e.g. "bf" for Burkina Faso
#   ORANGE_MONEY_NOTIF_URL                                 <- a publicly reachable URL (Orange calls this server-to-server); use ngrok or similar in dev
PAYMENT_PROVIDER=orange_money_sandbox
ORANGE_MONEY_CLIENT_ID=sandbox_client_id
ORANGE_MONEY_CLIENT_SECRET=sandbox_client_secret
ORANGE_MONEY_MERCHANT_KEY=demo_merchant
ORANGE_MONEY_API_BASE_URL=https://api.orange.com
ORANGE_MONEY_REGION=bf
ORANGE_MONEY_NOTIF_URL=http://localhost:3000/api/payments/orange-money/webhook

# Payment Provider - Stripe (Alternative)
STRIPE_SECRET_KEY=sk_test_your_test_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=wagesse-uploads

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NEXT_PUBLIC_FROM_EMAIL=noreply@wagesse.bf

# SMS Service
SMS_PROVIDER=twilio_sandbox
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Analytics & Logging
SENTRY_DSN=https://your_sentry_key@sentry.io/project_id

# Admin Panel
NEXT_PUBLIC_ADMIN_PATH=/admin
ADMIN_SECRET_TOKEN=super_secret_admin_token

# Mapbox (Optional, for maps)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Feature Flags
FEATURE_RECURRING_MISSIONS=true
FEATURE_ADVANCED_MATCHING=true
FEATURE_SUBSCRIPTION_PLANS=true
