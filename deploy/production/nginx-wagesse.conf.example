# Exemple à installer seulement après autorisation, sous un nom de fichier dédié.
# Ne pas modifier les autres vhosts. Ne pas utiliser default_server.
# Le certificat couvre uniquement le nom choisi. wagesse.fr pointe encore vers LWS.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name wagesse.fr www.wagesse.fr;

    # ssl_certificate     /etc/letsencrypt/live/wagesse.fr/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/wagesse.fr/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3030;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
