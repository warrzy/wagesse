# Modèle sans secret. Le script d'installation écrit /etc/wagesse/preprod.env
# sur le serveur, hors du dépôt Git.

NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Wagesse
NEXT_PUBLIC_APP_URL=https://preprod.wagesse.fr
NEXT_PUBLIC_CURRENCY=XOF

# Générés sur le serveur, jamais commités.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRATION=7d

# Circuit manuel. PayDunya reste inactif.
PAYMENT_MODE=MANUAL
PAYDUNYA_ENABLED=false
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# Le service de paiement est instancié au démarrage et n'accepte que des
# noms connus. orange_money_production sans clé ne peut pas encaisser.
# Le mode MANUAL n'emprunte pas ce fournisseur. Le bac à sable n'est pas sélectionné.
PAYMENT_PROVIDER=orange_money_production
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# SMS réel en attente du fournisseur. Pas de simulation sur une URL publique.
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_KEY=
SMS_SENDER=WAGESSE
SMS_COUNTRY_CODE=226
SMS_ALLOW_SIMULATE=
OTP_DEBUG_RETURN=

SEED_DEMO_ACCOUNTS=false
